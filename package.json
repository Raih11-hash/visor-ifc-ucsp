{
  "name": "visor-ifc-ucsp",
  "version": "2.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "uv run --no-project --python 3.11 --with playwright python scripts/smoke_v2.py && uv run --no-project --python 3.11 --with playwright python scripts/smoke_views_v21.py && uv run --no-project --python 3.11 --with playwright python scripts/smoke_layout_v21.py",
    "sync:engine": "node scripts/sync-engine.mjs"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.0",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-prettier": "5.1.3",
    "fake-indexeddb": "6.2.5",
    "prettier": "3.3.3",
    "typescript": "5.2.2",
    "vite": "7.3.6"
  },
  "dependencies": {
    "@thatopen/components": "3.4.8",
    "@thatopen/components-front": "3.4.4",
    "@thatopen/fragments": "3.4.7",
    "@thatopen/ui": "3.4.12",
    "@thatopen/ui-obc": "3.4.2",
    "camera-controls": "3.1.2",
    "three": "0.186.1",
    "web-ifc": "0.0.77"
  }
}
